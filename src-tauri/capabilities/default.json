{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:window:default",
    "core:window:allow-set-focus",
    "core:window:allow-set-fullscreen",
    "core:window:allow-show",
    "opener:default",
    "fs:default",
    "fs:allow-applocaldata-write",
    "fs:allow-read",
    "fs:allow-exists",
    "process:allow-exit",
    "dialog:default"
  ]
}
