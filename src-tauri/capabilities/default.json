{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:window:default",
    "core:window:allow-set-focus",
    "core:window:allow-set-fullscreen",
    "core:window:allow-show",
    "opener:default",
    "process:allow-exit",
    "dialog:default"
  ]
}